# Copy to .env (NEVER committed) and fill in. Read by the jobs and by `docker run --env-file .env`.
# --- Snowflake, key-pair auth (no password)
SNOWFLAKE_ACCOUNT=DPNIFMK-WG18146
# Airflow / demo machine: the service account. Local dev: your own user (LSTEFANI@ALBERTSCHOOL.COM, CLEMENT, ELIOTT)
SNOWFLAKE_USER=SVC_INGEST
SNOWFLAKE_ROLE=INGEST_ROLE
SNOWFLAKE_WAREHOUSE=INGEST_WH
SNOWFLAKE_DATABASE=MUTUELLE_FRAUD
# Path INSIDE the container: ~/keys/mutuelle is mounted read-only on /secrets (local dev: ~/keys -> /secrets, rsa_key.p8)
SNOWFLAKE_PRIVATE_KEY_FILE=/secrets/svc_ingest.p8
# --- CRM Postgres (local only). From a container on Mac, the host is host.docker.internal
PGHOST=host.docker.internal
PGPORT=5433
PGDATABASE=mutuelle_crm
PGUSER=crm
PGPASSWORD=change-me-locally
CRM_PASSWORD=change-me-locally
# --- data folder inside the container (mounted from ./data)
DATA_DIR=/data
