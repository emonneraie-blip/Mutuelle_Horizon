# Copier en airflow/.env et remplir. .env n'est JAMAIS commité.
# Chemins ABSOLUS sur la machine de démo (le Docker de la machine monte ces dossiers dans les tâches)
HOST_DATA_DIR=/Users/lucas/Mutuelle_Horizon/data
HOST_KEYS_DIR=/Users/lucas/keys/mutuelle

SNOWFLAKE_ACCOUNT=DPNIFMK-WG18146
SNOWFLAKE_DATABASE=MUTUELLE_FRAUD

# CRM Postgres local (docker-compose.crm.yml, port 5433 sur la machine)
PGHOST=host.docker.internal
PGPORT=5433
PGDATABASE=mutuelle_crm
PGUSER=crm
PGPASSWORD=change-me-locally

# Sel secret du hachage du NIR, utilisé par dbt (Clément). Même valeur pour tous les runs.
# Générer une fois : openssl rand -hex 16
NIR_SALT=

# Alerte Discord : Paramètres du salon > Intégrations > Webhooks > Copier l'URL
DISCORD_WEBHOOK_URL=

# 1 = les tâches affichent leur commande sans rien lancer (pour tester le DAG avant d'avoir les images)
PIPELINE_DRY_RUN=1
